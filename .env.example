# Database
# Use host "db" when running inside Docker Compose.
# Use host "localhost" when running uv/alembic/scrape.py on your machine
# against the Dockerized Postgres container (port 5432 must be exposed).
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/movies_db

# JWT signing (generate your own: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=d52fc661761311f92b779bde2a148921f72406cb2531490248c0667b324a0aa2

# JWT algorithm (default: HS256)
ALGORITHM=HS256

# JWT token lifetime in minutes (default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin credentials for POST /auth/login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secret